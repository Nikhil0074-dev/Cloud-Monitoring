{
  "name": "serverless-task-api",
  "version": "1.0.0",
  "description": "Serverless Task API (AWS Lambda + API Gateway HTTP API + DynamoDB)",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "offline": "serverless offline",
    "test": "node --test",
    "deploy": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "logs": "serverless logs -f createTask --tail",
    "remove": "serverless remove --stage dev"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "serverless": "^3.40.0",
    "serverless-offline": "^13.9.0"
  }
}
